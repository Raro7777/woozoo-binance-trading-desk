{
  "name": "woozoo-binance-trading-desk",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@7.33.7",
  "engines": {
    "node": ">=20.9.0 <25"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "scripts": {
    "bootstrap": "node scripts/bootstrap.mjs",
    "env:init": "node scripts/env-init.mjs",
    "lint": "node scripts/quality.mjs lint",
    "typecheck": "node scripts/quality.mjs typecheck",
    "test:unit": "node scripts/quality.mjs test:unit",
    "test:contracts": "node scripts/quality.mjs test:contracts",
    "test:safety": "node scripts/quality.mjs test:safety",
    "test:integration": "node scripts/quality.mjs test:integration",
    "test:property": "node scripts/quality.mjs test:property",
    "test:replay": "node scripts/quality.mjs test:replay",
    "test:failure": "node scripts/quality.mjs test:failure",
    "test:e2e": "node scripts/quality.mjs test:e2e",
    "test:acceptance": "node scripts/quality.mjs test:acceptance",
    "worker:paper": "python -m uv run --locked python -m paper_engine.authorization_worker",
    "worker:testnet-execution": "python -m uv run --locked python scripts/run-testnet-execution-worker.py",
    "worker:spot-testnet-gateway": "python -m uv run --locked python scripts/run-spot-testnet-gateway-worker.py",
    "testnet:local:start": "node scripts/run-phase8-testnet-local.mjs",
    "build": "node scripts/quality.mjs build",
    "ci": "node scripts/quality.mjs ci"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.61.1",
    "@types/node": "^24.0.0",
    "playwright-core": "1.61.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
