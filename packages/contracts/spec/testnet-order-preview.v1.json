{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "woozoo.testnet-order-preview/v1",
  "x-creation-phase": 8,
  "x-activation-phase": 8,
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "environment", "account_binding_id", "account_generation", "proposal_id", "proposal_hash", "evidence_id", "evidence_digest", "data_state_digest", "as_of", "knowledge_cutoff", "symbol", "side", "order_type", "time_in_force", "quantity", "limit_price", "worst_case_notional", "fee_reserve", "preview_policy_version", "calculator_version", "symbol_rules_digest", "ledger_snapshot_digest", "reconciliation_checkpoint_digest", "paper_kill_version", "testnet_barrier_version", "client_order_id", "created_at", "expires_at", "testnet_order_preview_digest"],
  "properties": {
    "schema_version": {"const": "woozoo.testnet-order-preview/v1"},
    "environment": {"const": "BINANCE_SPOT_TESTNET"},
    "account_binding_id": {"$ref": "#/$defs/hash"},
    "account_generation": {"type": "integer", "minimum": 1},
    "proposal_id": {"$ref": "#/$defs/hash"},
    "proposal_hash": {"$ref": "#/$defs/hash"},
    "evidence_id": {"$ref": "#/$defs/hash"},
    "evidence_digest": {"$ref": "#/$defs/hash"},
    "data_state_digest": {"$ref": "#/$defs/hash"},
    "as_of": {"type": "string", "format": "date-time"},
    "knowledge_cutoff": {"type": "string", "format": "date-time"},
    "symbol": {"enum": ["BTCUSDT", "ETHUSDT"]},
    "side": {"enum": ["BUY", "SELL"]},
    "order_type": {"const": "LIMIT"},
    "time_in_force": {"const": "GTC"},
    "quantity": {"$ref": "#/$defs/positiveDecimal"},
    "limit_price": {"$ref": "#/$defs/positiveDecimal"},
    "worst_case_notional": {"$ref": "#/$defs/nonNegativeDecimal"},
    "fee_reserve": {"$ref": "#/$defs/nonNegativeDecimal"},
    "preview_policy_version": {"const": "woozoo.testnet-order-preview-policy/v1"},
    "calculator_version": {"const": "woozoo.decimal-calculator/v1"},
    "symbol_rules_digest": {"$ref": "#/$defs/hash"},
    "ledger_snapshot_digest": {"$ref": "#/$defs/hash"},
    "reconciliation_checkpoint_digest": {"$ref": "#/$defs/hash"},
    "paper_kill_version": {"type": "integer", "minimum": 0},
    "testnet_barrier_version": {"type": "integer", "minimum": 0},
    "client_order_id": {"type": "string", "pattern": "^wz8-[a-f0-9]{32}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "testnet_order_preview_digest": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "positiveDecimal": {"type": "string", "pattern": "^(?:0\\.(?:0*[1-9][0-9]*)|[1-9][0-9]*(?:\\.[0-9]+)?)$"},
    "nonNegativeDecimal": {"type": "string", "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"}
  }
}
