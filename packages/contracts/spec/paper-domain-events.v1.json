{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "woozoo.paper-domain-events/v1",
  "title": "Dormant Phase 4 Paper event registry",
  "x-creation-phase": 4,
  "x-activation-phase": 7,
  "oneOf": [
    {"$ref": "#/$defs/orderAccepted"},
    {"$ref": "#/$defs/orderPartiallyFilled"},
    {"$ref": "#/$defs/orderFilled"},
    {"$ref": "#/$defs/orderCancelled"},
    {"$ref": "#/$defs/ledgerPosted"}
  ],
  "$defs": {
    "base": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spec_version", "event_id", "event_type", "event_version", "occurred_at", "producer", "activation_phase", "aggregate_id", "aggregate_version", "payload_hash"],
      "properties": {
        "spec_version": {"const": "woozoo.event/v1"},
        "event_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "event_type": {"type": "string"},
        "event_version": {"const": 1},
        "occurred_at": {"type": "string", "format": "date-time"},
        "producer": {"const": "paper-engine"},
        "activation_phase": {"const": 7},
        "aggregate_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "aggregate_version": {"type": "integer", "minimum": 1},
        "payload_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "orderAccepted": {"allOf": [{"$ref": "#/$defs/base"}, {"properties": {"event_type": {"const": "paper.order.accepted.v1"}}}]},
    "orderPartiallyFilled": {"allOf": [{"$ref": "#/$defs/base"}, {"properties": {"event_type": {"const": "paper.order.partially-filled.v1"}}}]},
    "orderFilled": {"allOf": [{"$ref": "#/$defs/base"}, {"properties": {"event_type": {"const": "paper.order.filled.v1"}}}]},
    "orderCancelled": {"allOf": [{"$ref": "#/$defs/base"}, {"properties": {"event_type": {"const": "paper.order.cancelled.v1"}}}]},
    "ledgerPosted": {"allOf": [{"$ref": "#/$defs/base"}, {"properties": {"event_type": {"const": "ledger.transaction.posted.v1"}}}]}
  }
}
