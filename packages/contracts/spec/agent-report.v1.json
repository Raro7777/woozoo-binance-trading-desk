{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "woozoo.agent-report/v1",
  "title": "Phase 6 Evidence-bound agent report",
  "type": "object",
  "additionalProperties": false,
  "x-creation-phase": 6,
  "x-activation-phase": 7,
  "required": ["schema_version", "report_id", "run_id", "role", "report_version", "evidence_id", "evidence_digest", "as_of", "knowledge_cutoff", "symbol", "evidence_item_ids", "dependency_report_ids", "claim_times", "findings", "uncertainty", "invalidation_conditions", "confidence", "stance", "provider", "model", "prompt_manifest_hash", "workflow_hash", "report_hash"],
  "properties": {
    "schema_version": {"const": "woozoo.agent-report/v1"},
    "report_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "run_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "role": {"enum": ["MARKET_REGIME", "TECHNICAL", "TRADE_FLOW", "BULL", "BEAR", "TRADER", "PORTFOLIO", "AUDIT"]},
    "report_version": {"const": "v1"},
    "evidence_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "evidence_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "as_of": {"type": "string", "format": "date-time"},
    "knowledge_cutoff": {"type": "string", "format": "date-time"},
    "symbol": {"enum": ["BTCUSDT", "ETHUSDT"]},
    "evidence_item_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
    "dependency_report_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
    "claim_times": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"type": "string", "format": "date-time"}},
    "findings": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"type": "string", "minLength": 1, "maxLength": 512}},
    "uncertainty": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "string", "minLength": 1, "maxLength": 512}},
    "invalidation_conditions": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "string", "minLength": 1, "maxLength": 512}},
    "confidence": {"type": "string", "pattern": "^(0|0\\.[0-9]{1,6}|1(?:\\.0{1,6})?)$"},
    "stance": {"enum": ["BUY", "SELL", "HOLD", "NEUTRAL"]},
    "provider": {"const": "mock"},
    "model": {"const": "woozoo-deterministic-mock/v1"},
    "prompt_manifest_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "workflow_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "report_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
