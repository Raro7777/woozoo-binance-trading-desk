{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "woozoo.testnet-risk-input/v1",
  "x-creation-phase": 8,
  "x-activation-phase": 8,
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "namespace", "environment", "account_binding_id", "account_generation", "proposal_id", "proposal_hash", "testnet_order_preview", "testnet_order_preview_digest", "data_state_digest", "ledger_snapshot_digest", "reconciliation_checkpoint_digest", "paper_kill_version", "paper_kill_active", "testnet_barrier_version", "testnet_barrier_active", "gateway_configuration_digest", "gateway_allowlist_digest", "gateway_status", "policy_version", "evaluated_at", "risk_input_digest"],
  "properties": {
    "schema_version": {"const": "woozoo.testnet-risk-input/v1"},
    "namespace": {"const": "testnet"},
    "environment": {"const": "BINANCE_SPOT_TESTNET"},
    "account_binding_id": {"$ref": "#/$defs/hash"},
    "account_generation": {"type": "integer", "minimum": 1},
    "proposal_id": {"$ref": "#/$defs/hash"},
    "proposal_hash": {"$ref": "#/$defs/hash"},
    "testnet_order_preview": {"$ref": "testnet-order-preview.v1.json"},
    "testnet_order_preview_digest": {"$ref": "#/$defs/hash"},
    "data_state_digest": {"$ref": "#/$defs/hash"},
    "ledger_snapshot_digest": {"$ref": "#/$defs/hash"},
    "reconciliation_checkpoint_digest": {"$ref": "#/$defs/hash"},
    "paper_kill_version": {"type": "integer", "minimum": 0},
    "paper_kill_active": {"type": "boolean"},
    "testnet_barrier_version": {"type": "integer", "minimum": 0},
    "testnet_barrier_active": {"type": "boolean"},
    "gateway_configuration_digest": {"$ref": "#/$defs/hash"},
    "gateway_allowlist_digest": {"$ref": "#/$defs/hash"},
    "gateway_status": {"enum": ["DISABLED", "ACTIVATING", "READY", "DEGRADED", "UNKNOWN", "RESET_HOLD", "KILLED"]},
    "policy_version": {"const": "woozoo.testnet-risk-policy/v1"},
    "evaluated_at": {"type": "string", "format": "date-time"},
    "risk_input_digest": {"$ref": "#/$defs/hash"}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
