{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "woozoo.risk-domain-events/v1",
  "title": "Dormant Phase 5 Risk event registry",
  "x-creation-phase": 5,
  "x-activation-phase": 7,
  "oneOf": [
    {"$ref": "#/$defs/riskDecisionRecorded"},
    {"$ref": "#/$defs/killSwitchActivated"}
  ],
  "$defs": {
    "base": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spec_version", "event_id", "event_type", "event_version", "occurred_at", "producer", "activation_phase", "aggregate_id", "aggregate_version", "payload_hash", "data"],
      "properties": {
        "spec_version": {"const": "woozoo.event/v1"},
        "event_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "event_type": {"type": "string"},
        "event_version": {"const": 1},
        "occurred_at": {"type": "string", "format": "date-time"},
        "producer": {"const": "risk-engine"},
        "activation_phase": {"const": 7},
        "aggregate_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "aggregate_version": {"type": "integer", "minimum": 1},
        "payload_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "data": {"type": "object"}
      }
    },
    "riskDecisionRecorded": {"allOf": [{"$ref": "#/$defs/base"}, {"properties": {"event_type": {"const": "risk.decision.recorded.v1"}, "data": {"$ref": "risk-decision.v1.json"}}}]},
    "killSwitchActivated": {"allOf": [{"$ref": "#/$defs/base"}, {"properties": {"event_type": {"const": "kill-switch.activated.v1"}, "data": {"$ref": "kill-switch.v1.json"}}}]}
  }
}
