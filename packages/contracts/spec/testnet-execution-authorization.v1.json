{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "woozoo.testnet-execution-authorization/v1",
  "x-creation-phase": 8,
  "x-activation-phase": 8,
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "authorization_id", "namespace", "environment", "account_binding_id", "account_generation", "approval_id", "approval_hash", "approval_nonce_hash", "authorization_nonce", "proposal_id", "proposal_hash", "risk_decision_id", "risk_decision_hash", "risk_input_digest", "risk_policy_version", "preview_policy_version", "testnet_order_preview_digest", "authorization_input_digest", "data_state_digest", "activation_version", "paper_kill_version", "testnet_barrier_version", "gateway_configuration_digest", "gateway_allowlist_digest", "reconciliation_checkpoint_digest", "ledger_snapshot_digest", "client_order_id", "issued_at", "expires_at"],
  "properties": {
    "schema_version": {"const": "woozoo.testnet-execution-authorization/v1"},
    "authorization_id": {"$ref": "#/$defs/hash"},
    "namespace": {"const": "testnet"},
    "environment": {"const": "BINANCE_SPOT_TESTNET"},
    "account_binding_id": {"$ref": "#/$defs/hash"},
    "account_generation": {"type": "integer", "minimum": 1},
    "approval_id": {"$ref": "#/$defs/hash"},
    "approval_hash": {"$ref": "#/$defs/hash"},
    "approval_nonce_hash": {"$ref": "#/$defs/hash"},
    "authorization_nonce": {"type": "string", "pattern": "^[A-Za-z0-9_-]{32,128}$"},
    "proposal_id": {"$ref": "#/$defs/hash"},
    "proposal_hash": {"$ref": "#/$defs/hash"},
    "risk_decision_id": {"$ref": "#/$defs/hash"},
    "risk_decision_hash": {"$ref": "#/$defs/hash"},
    "risk_input_digest": {"$ref": "#/$defs/hash"},
    "risk_policy_version": {"const": "woozoo.testnet-risk-policy/v1"},
    "preview_policy_version": {"const": "woozoo.testnet-order-preview-policy/v1"},
    "testnet_order_preview_digest": {"$ref": "#/$defs/hash"},
    "authorization_input_digest": {"$ref": "#/$defs/hash"},
    "data_state_digest": {"$ref": "#/$defs/hash"},
    "activation_version": {"type": "integer", "minimum": 1},
    "paper_kill_version": {"type": "integer", "minimum": 0},
    "testnet_barrier_version": {"type": "integer", "minimum": 0},
    "gateway_configuration_digest": {"$ref": "#/$defs/hash"},
    "gateway_allowlist_digest": {"$ref": "#/$defs/hash"},
    "reconciliation_checkpoint_digest": {"$ref": "#/$defs/hash"},
    "ledger_snapshot_digest": {"$ref": "#/$defs/hash"},
    "client_order_id": {"type": "string", "pattern": "^wz8-[a-f0-9]{32}$"},
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
