{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "woozoo.testnet-gateway-command/v1",
  "x-creation-phase": 8,
  "x-activation-phase": 8,
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "command_id", "command_type", "effect_class", "producer", "environment", "account_binding_id", "account_generation", "idempotency_key", "request_digest", "correlation_id", "causation_id", "capability_id", "gateway_allowlist_digest", "gateway_configuration_digest", "activation_version", "testnet_barrier_version", "original_authorization_id", "original_approval_id", "original_proposal_hash", "original_risk_decision_hash", "client_order_id", "symbol", "side", "quantity", "limit_price", "query_reason", "issued_at", "expires_at"],
  "properties": {
    "schema_version": {"const": "woozoo.testnet-gateway-command/v1"},
    "command_id": {"$ref": "#/$defs/hash"},
    "command_type": {"enum": ["SUBMIT_LIMIT_ORDER", "CANCEL_EXISTING_ORDER", "QUERY_EXISTING_ORDER", "RECONCILIATION_OBSERVATION"]},
    "effect_class": {"enum": ["CREATE_ORDER", "REDUCE_OR_CANCEL", "OBSERVE_ONLY"]},
    "producer": {"const": "testnet-execution-service"},
    "environment": {"const": "BINANCE_SPOT_TESTNET"},
    "account_binding_id": {"$ref": "#/$defs/hash"},
    "account_generation": {"type": "integer", "minimum": 1},
    "idempotency_key": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"},
    "request_digest": {"$ref": "#/$defs/hash"},
    "correlation_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "causation_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "capability_id": {"enum": ["SPOT_TESTNET_SUBMIT_LIMIT_GTC", "SPOT_TESTNET_CANCEL_BY_CLIENT_ID", "SPOT_TESTNET_QUERY_BY_CLIENT_ID", "SPOT_TESTNET_RECONCILIATION"]},
    "gateway_allowlist_digest": {"$ref": "#/$defs/hash"},
    "gateway_configuration_digest": {"$ref": "#/$defs/hash"},
    "activation_version": {"type": "integer", "minimum": 1},
    "testnet_barrier_version": {"type": "integer", "minimum": 0},
    "original_authorization_id": {"$ref": "#/$defs/hash"},
    "original_approval_id": {"$ref": "#/$defs/hash"},
    "original_proposal_hash": {"$ref": "#/$defs/hash"},
    "original_risk_decision_hash": {"$ref": "#/$defs/hash"},
    "client_order_id": {"type": "string", "pattern": "^wz8-[a-f0-9]{32}$"},
    "symbol": {"enum": ["BTCUSDT", "ETHUSDT"]},
    "side": {"enum": ["BUY", "SELL"]},
    "quantity": {"$ref": "#/$defs/positiveDecimal"},
    "limit_price": {"$ref": "#/$defs/positiveDecimal"},
    "query_reason": {"enum": ["INITIAL_SUBMIT", "OPERATOR_CANCEL", "SAFETY_CANCEL", "UNKNOWN_OUTCOME", "PERIODIC_RECONCILIATION"]},
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "positiveDecimal": {"type": "string", "pattern": "^(?:0\\.(?:0*[1-9][0-9]*)|[1-9][0-9]*(?:\\.[0-9]+)?)$"}
  }
}
