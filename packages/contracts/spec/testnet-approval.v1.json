{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "woozoo.testnet-approval/v1",
  "x-creation-phase": 8,
  "x-activation-phase": 8,
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "approval_id", "proposal_id", "proposal_hash", "risk_decision_id", "risk_decision_hash", "risk_input_digest", "risk_policy_version", "preview_policy_version", "environment", "account_binding_id", "account_generation", "testnet_order_preview", "testnet_order_preview_digest", "approval_input_digest", "actor_id", "session_binding_hash", "csrf_binding_hash", "origin_hash", "decision", "validity", "approval_nonce", "expected_activation_version", "expected_paper_kill_version", "expected_testnet_barrier_version", "expected_ledger_version", "expected_reconciliation_version", "approved_at", "expires_at", "revocation_state", "payload_hash"],
  "properties": {
    "schema_version": {"const": "woozoo.testnet-approval/v1"},
    "approval_id": {"$ref": "#/$defs/hash"},
    "proposal_id": {"$ref": "#/$defs/hash"},
    "proposal_hash": {"$ref": "#/$defs/hash"},
    "risk_decision_id": {"$ref": "#/$defs/hash"},
    "risk_decision_hash": {"$ref": "#/$defs/hash"},
    "risk_input_digest": {"$ref": "#/$defs/hash"},
    "risk_policy_version": {"const": "woozoo.testnet-risk-policy/v1"},
    "preview_policy_version": {"const": "woozoo.testnet-order-preview-policy/v1"},
    "environment": {"const": "BINANCE_SPOT_TESTNET"},
    "account_binding_id": {"$ref": "#/$defs/hash"},
    "account_generation": {"type": "integer", "minimum": 1},
    "testnet_order_preview": {"$ref": "testnet-order-preview.v1.json"},
    "testnet_order_preview_digest": {"$ref": "#/$defs/hash"},
    "approval_input_digest": {"$ref": "#/$defs/hash"},
    "actor_id": {"const": "operator-local-1"},
    "session_binding_hash": {"$ref": "#/$defs/hash"},
    "csrf_binding_hash": {"$ref": "#/$defs/hash"},
    "origin_hash": {"$ref": "#/$defs/hash"},
    "decision": {"enum": ["APPROVED", "REJECTED"]},
    "validity": {"enum": ["ACTIVE", "EXPIRED", "REVOKED", "INVALIDATED"]},
    "approval_nonce": {"type": "string", "pattern": "^[A-Za-z0-9_-]{32,128}$"},
    "expected_activation_version": {"type": "integer", "minimum": 0},
    "expected_paper_kill_version": {"type": "integer", "minimum": 0},
    "expected_testnet_barrier_version": {"type": "integer", "minimum": 0},
    "expected_ledger_version": {"type": "integer", "minimum": 0},
    "expected_reconciliation_version": {"type": "integer", "minimum": 0},
    "approved_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "revocation_state": {"enum": ["NOT_REVOKED", "REVOKED"]},
    "payload_hash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
